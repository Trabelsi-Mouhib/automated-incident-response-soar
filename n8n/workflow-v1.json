        "jsCode": "const body = $input.first().json.body;\n\nconst alertLevel = body.rule.level || 'Inconnu';\nconst description = body.rule.description || 'Pas de description';\nconst ruleId = body.rule.id || 'N/A';\nconst srcIp = body.data?.srcip || 'N/A';\nconst targetAgent = body.agent?.name || 'Inconnu';\nconst targetIp = body.agent?.ip || 'N/A';\nconst fullLog = body.full_log || 'Aucun log brut';\nconst timestamp = body.timestamp || new Date().toISOString();\n\nconst formattedMessage = `🚨 **ALERTE SOC - SÉVÉRITÉ ${alertLevel}** 🚨\\n\\n` +\n  `**Règle :** ${description} (ID:${ruleId})\\n` +\n  `**Attaquant (IP Source) :** \\`${srcIp}\\`\\n` +\n  `**Cible :** ${targetAgent} (\\`${targetIp}\\`)\\n` +\n  `**Horodatage :** ${timestamp}\\n\\n` +\n  `**Log brut :**\\n\\`\\`\\`${fullLog}\\`\\`\\``;\n\nreturn [{\n  json: {\n    formattedMessage,\n    srcIp,\n    targetAgent,\n    alertLevel\n  }\n}];"
